# Public template only. Copy to .env for local use, then fill secrets privately.
# On Render, add the same names under Service > Environment. Never commit real secrets.

PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Google Identity Services (OAuth client type: Web application).
GOOGLE_CLIENT_ID=

# Optional: restrict login to one managed Google Workspace domain.
# Leave empty to accept any verified Google account.
GOOGLE_ALLOWED_EMAIL_DOMAIN=

# Google reCAPTCHA v3 keys for the free Render host and your future custom domain.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_VERSION=v3
RECAPTCHA_ACTION=login
RECAPTCHA_MINIMUM_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,neon-studios-system-academy.onrender.com,neonstudiosacademy.com.br,www.neonstudiosacademy.com.br

# Fixed 32-byte-or-longer secret. Keep the same value across Render deploys.
AUTH_SESSION_SECRET=
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_RATE_LIMIT_MAX=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=600
TRUST_PROXY=false

# TikTok Developer Portal app credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.list

# Shared secret sent by Roblox server requests in the x-game-secret header.
ROBLOX_SHARED_SECRET=

# How long Roblox-facing reel metadata can stay cached.
REELS_CACHE_TTL_SECONDS=43200

# Optional: Pexels API key for downloading royalty-free ambient/nature videos.
# Get one at https://www.pexels.com/api/
PEXELS_API_KEY=
