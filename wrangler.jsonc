{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neon-studios-system-academy",
  "main": "server/src/worker.js",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "./.cloudflare/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "CLOUDFLARE_WORKERS": "true",
    "NODE_ENV": "production",
    "PORT": "3000",
    "TRUST_PROXY": "true",
    "RECAPTCHA_MINIMUM_SCORE": "0.3",
    "COMMUNITY_ENABLED": "false",
    "PROMOTIONAL_PRICES_VERIFIED": "false"
  }
}
